# ── Secrets & environment ─────────────────────────────────────
.env

# ── Collected image data (large, machine-generated) ──────────
data/
data_*/

# ── Model artifacts (binary, regenerable) ────────────────────
*.pkl
*.pt
*.pth
*.h5
*.onnx

# ── MediaPipe model file (download separately, ~25 MB) ───────
*.task

# ── Python bytecode & cache ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.ruff_cache/
.mypy_cache/
.pytype/
.pytest_cache/

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Build / packaging ─────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Test & coverage reports ───────────────────────────────────
htmlcov/
.coverage
.coverage.*
coverage.xml

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Debug / temporary output ──────────────────────────────────
snapshot_*.png
*.log

# ── IDE / editor ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS noise ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
